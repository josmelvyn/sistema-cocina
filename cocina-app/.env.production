# Database
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}

# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sistema-cocina-production.up.railway.app

# Laravel extras (opcionales, pero recomendados)
APP_KEY=base64:TuClaveLaravelAqui
LOG_CHANNEL=stack
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync